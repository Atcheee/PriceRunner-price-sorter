{
  "name": "pricerunner-price-sorter",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:popup && npm run build:content-css",
    "build:content-css": "tailwindcss -i src/content.css -o styles.css --minify",
    "build:popup": "vite build",
    "dev": "vite",
    "package": "npm run validate && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "validate": "npm test && npm run build && node scripts/validate.mjs",
    "test": "node --test --test-isolation=none"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
