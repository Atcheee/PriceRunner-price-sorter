{
  "manifest_version": 3,
  "name": "PriceRunner Extension 2.0",
  "version": "2.0.0",
  "description": "Sortera, analysera och exportera PriceRunner-bevakningar lokalt och transparent.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "PriceRunner Extension",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pricerunner.se/*",
        "https://*.pricerunner.dk/*",
        "https://*.pricerunner.no/*",
        "https://*.pricerunner.fi/*",
        "https://*.pricerunner.com/*"
      ],
      "js": [
        "core.js",
        "page-parser.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
